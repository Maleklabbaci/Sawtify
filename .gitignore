# Dependencies and generated build output
node_modules/
dist/

# Local secrets and environment configuration
.env
.env.*
!.env.example

# exports temporaires pour Google Drive (générés localement)
marketing/instagram/drive_export/
# textures générées par `premium_fx.py --pack`
marketing/instagram/textures/
marketing/instagram/slides/bank-*/
!marketing/instagram/slides/bank-002/
!marketing/instagram/slides/bank-057/
!marketing/instagram/slides/bank-140/

# archives extras reconstruites par zip_extras.py (dérivées des dossiers square/ et story/)
marketing/instagram/slides/*/extras-*.zip
# caches python générés localement
marketing/instagram/__pycache__/
# banque de photos de travail (stock libre, remplaçables par les photos de la marque)
marketing/instagram/image-search/
